# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FIREBASE CONFIGURATION: Key properties to initialize dynamic dynamic Firebase services
FIREBASE_API_KEY=AIzaSy_Placeholder_Firebase_API_Key
FIREBASE_APPLICATION_ID=1:1234567890:android:placeholderapp
FIREBASE_PROJECT_ID=placeholder-firebase-project
